#!/bin/bash
set -e

echo "=== Starting Vault Secrets Management Server ==="

# Configuration
Vault_PORT=${Vault_PORT:-8020}
Vault_DB_HOST=${Vault_DB_HOST:-localhost}
Vault_DB_PORT=${Vault_DB_PORT:-5437}
Vault_DB_NAME=${Vault_DB_NAME:-vault}
Vault_DB_USER=${Vault_DB_USER:-vault}
Vault_DB_PASSWORD=${Vault_DB_PASSWORD:-vault-secure-password}

# Wait for PostgreSQL backend to be ready (if using database backend)
if [ -n "$Vault_DB_HOST" ]; then
  echo "Waiting for database backend at $Vault_DB_HOST:$Vault_DB_PORT..."
  max_attempts=30
  attempt=0
  until PGPASSWORD="$Vault_DB_PASSWORD" psql -h "$Vault_DB_HOST" -p "$Vault_DB_PORT" -U "$Vault_DB_USER" -d "$Vault_DB_NAME" -c "SELECT 1" > /dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ $attempt -gt $max_attempts ]; then
      echo "Database backend failed to start after $max_attempts attempts"
      exit 1
    fi
    echo "Database not ready, waiting... ($attempt/$max_attempts)"
    sleep 2
  done
  echo "Database backend is ready!"
fi

# Create necessary directories
mkdir -p /var/lib/vault /var/log/vault

# Initialize Vault configuration if not present
if [ ! -f /etc/vault/.initialized ]; then
  echo "Initializing Vault for first run..."
  
  # Set environment variables for Vault
  export Vault_PORT=$Vault_PORT
  export DATABASE_URL="postgresql://${Vault_DB_USER}:${Vault_DB_PASSWORD}@${Vault_DB_HOST}:${Vault_DB_PORT}/${Vault_DB_NAME}"
  export NODE_ENV=production
  
  # Create initialization marker
  touch /etc/vault/.initialized
  echo "Vault initialization complete"
fi

# Start Vault server
echo "Starting Vault server on port $Vault_PORT..."
exec vault run -- node /app/server.js
