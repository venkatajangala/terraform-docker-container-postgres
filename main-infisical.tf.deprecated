# ============================================================================
# Vault Secrets Management Infrastructure
# NOTE: random_password resources are defined in main-ha.tf
# ============================================================================

# ============================================================================
# Redis Cache (required by Vault server)
# ============================================================================

resource "docker_image" "redis" {
  count = var.vault_enabled ? 1 : 0
  name  = "redis:7-alpine"
}

resource "docker_container" "vault_redis" {
  count   = var.vault_enabled ? 1 : 0
  name    = "vault-redis"
  image   = docker_image.redis[0].image_id
  restart = "unless-stopped"

  networks_advanced {
    name = docker_network.pg_ha_network.name
  }

  healthcheck {
    test     = ["CMD", "redis-cli", "ping"]
    interval = "10s"
    timeout  = "5s"
    retries  = 5
  }
}

# ============================================================================
# Vault PostgreSQL Backend Database
# ============================================================================

resource "docker_image" "postgres_vault" {
  count = var.vault_enabled ? 1 : 0
  name  = "postgres:18-bookworm"
}

resource "docker_volume" "vault_db_data" {
  count = var.vault_enabled ? 1 : 0
  name  = "vault-db-data"
}

resource "docker_container" "vault_postgres" {
  count   = var.vault_enabled ? 1 : 0
  name    = "vault-postgres"
  image   = docker_image.postgres_vault[0].image_id
  restart = "unless-stopped"

  env = [
    "POSTGRES_DB=vault",
    "POSTGRES_USER=vault",
    "POSTGRES_PASSWORD=${random_password.vault_db_password.result}",
    "PGDATA=/var/lib/postgresql/data/pgdata"
  ]

  ports {
    internal = 5432
    external = var.vault_db_port
  }

  mounts {
    target = "/var/lib/postgresql/data"
    source = docker_volume.vault_db_data[0].name
    type   = "volume"
  }

  networks_advanced {
    name = docker_network.pg_ha_network.name
  }

  healthcheck {
    test     = ["CMD-SHELL", "pg_isready -U vault -d vault"]
    interval = "10s"
    timeout  = "5s"
    retries  = 5
  }
}

# ============================================================================
# Vault Secrets Management Service
# ============================================================================

resource "docker_image" "vault" {
  count = var.vault_enabled ? 1 : 0
  name  = "vault/vault:latest"
}

resource "docker_volume" "vault_data" {
  count = var.vault_enabled ? 1 : 0
  name  = "vault-data"
}

resource "docker_container" "vault" {
  count   = var.vault_enabled ? 1 : 0
  name    = "vault"
  image   = docker_image.vault[0].image_id
  restart = "unless-stopped"

  env = [
    "DB_CONNECTION_URI=postgresql://vault:${random_password.vault_db_password.result}@vault-postgres:5432/vault",
    "REDIS_URL=redis://vault-redis:6379",
    "ENCRYPTION_KEY=${substr(random_password.vault_api_key.result, 0, 32)}",
    "AUTH_SECRET=${random_password.pgbouncer_admin_password.result}",
    "SITE_URL=http://localhost:${var.vault_port}",
    "PORT=8080",
    "NODE_ENV=production"
  ]

  ports {
    internal = 8080
    external = var.vault_port
  }

  mounts {
    target = "/var/lib/vault"
    source = docker_volume.vault_data[0].name
    type   = "volume"
  }

  networks_advanced {
    name = docker_network.pg_ha_network.name
  }

  depends_on = [
    docker_container.vault_postgres,
    docker_container.vault_redis
  ]

  healthcheck {
    test     = ["CMD", "curl", "-f", "http://localhost:8080/api/status"]
    interval = "15s"
    timeout  = "5s"
    retries  = 3
  }
}

# ============================================================================
# Initialize Secrets in Vault
# ============================================================================

resource "null_resource" "vault_init_secrets" {
  count = var.vault_enabled && var.generate_new_passwords ? 1 : 0

  triggers = {
    vault_container_id = try(docker_container.vault[0].id, "")
  }

  provisioner "local-exec" {
    command = <<-EOT
      #!/bin/bash
      set -e
      
      echo "Waiting for Vault to be ready..."
      sleep 5
      
      max_retries=30
      attempt=0
      until curl -s http://localhost:${var.vault_port}/api/status > /dev/null 2>&1; do
        attempt=$((attempt + 1))
        if [ $attempt -gt $max_retries ]; then
          echo "Vault failed to start after $max_retries attempts"
          exit 1
        fi
        echo "Attempt $attempt/$max_retries: Waiting for Vault..."
        sleep 2
      done
      
      echo "Vault is ready! Creating secrets..."
      echo "Secrets should be created in Vault via:"
      echo "1. Navigate to: http://localhost:${var.vault_port}"
      echo "2. Create project and environment"
      echo "3. Add the following secrets:"
      echo "   - db-admin-password: ${random_password.db_admin_password.result}"
      echo "   - db-replication-password: ${random_password.db_replication_password.result}"
      echo "   - pgbouncer-admin-password: ${random_password.pgbouncer_admin_password.result}"
    EOT
  }

  depends_on = [docker_container.vault]
}

# ============================================================================
# Output: Vault Configuration
# ============================================================================

output "vault_url" {
  description = "Vault service URL"
  value       = var.vault_enabled ? "http://localhost:${var.vault_port}" : "Vault disabled"
}

output "vault_db_host" {
  description = "Vault PostgreSQL database host"
  value       = var.vault_enabled ? "vault-postgres" : "N/A"
}

output "vault_db_port" {
  description = "Vault PostgreSQL database port"
  value       = var.vault_enabled ? var.vault_db_port : "N/A"
}

output "generated_passwords" {
  description = "Generated passwords for initial setup (store securely in Vault)"
  sensitive   = true
  value = var.generate_new_passwords ? {
    db_admin_password        = random_password.db_admin_password.result
    db_replication_password  = random_password.db_replication_password.result
    pgbouncer_admin_password = random_password.pgbouncer_admin_password.result
    vault_api_key        = random_password.vault_api_key.result
  } : {}
}
