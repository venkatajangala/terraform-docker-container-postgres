.vscode/

# Rendered Patroni configs contain plaintext passwords — never commit
patroni/rendered/

# Terraform state contains plaintext passwords and infra details — never commit
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.*.backup
.terraform/

# Local tooling — not part of the stack
litellm.log
litellm_config.yaml
start-claude.sh

# Vault AppRole bootstrap credentials — contain plaintext role_id/secret_id, never commit
.vault-bootstrap/

# Datadog rendered integration configs — contain plaintext database passwords, never commit
datadog/rendered/

# Dashboard rendered nginx config — regenerated by terraform apply
dashboard/rendered/

# Prometheus rendered scrape config — regenerated by terraform apply
monitoring/rendered/
