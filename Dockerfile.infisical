FROM node:20-bookworm

# Install ONLY required dependencies in single layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install Vault CLI and SDK
RUN npm install -g @vault/cli && \
    npm cache clean --force

# Create directories for Vault (consolidated)
RUN mkdir -p /var/lib/vault /etc/vault /var/log/vault && \
    chown -R node:node /var/lib/vault /etc/vault /var/log/vault

# Set working directory
WORKDIR /app

# Copy entrypoint script
COPY entrypoint-vault.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint-vault.sh

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8020/api/v1/health || exit 1

# Expose Vault API port
EXPOSE 8020

ENTRYPOINT ["/usr/local/bin/entrypoint-vault.sh"]
CMD ["node", "/app/server.js"]
