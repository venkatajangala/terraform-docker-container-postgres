#!/usr/bin/env bash
# Auto-update the **Last Updated** date in README.md when staged files match
# a "major change" pattern. Re-stages README.md so the bump joins the commit.
#
# Enable per-clone: bash scripts/install-hooks.sh

set -euo pipefail

README="README.md"
DATE_PREFIX='**Last Updated**:'

# Staged paths trigger a date bump if any match these extended-regex patterns.
MAJOR_PATTERNS=(
  '\.tf$'
  '^Dockerfile'
  '\.sh$'
  '\.tpl$'
  '\.py$'
  '\.ya?ml$'
  '\.md$'
  '\.hcl$'
)

# Honor --no-verify, merges, and rebases by exiting cleanly when there is
# nothing to do.
staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
[ -z "$staged" ] && exit 0
[ -f "$README" ] || exit 0

major=0
while IFS= read -r path; do
  [ -z "$path" ] && continue
  for pat in "${MAJOR_PATTERNS[@]}"; do
    if printf '%s\n' "$path" | grep -Eq "$pat"; then
      major=1
      break 2
    fi
  done
done <<< "$staged"

[ "$major" -eq 0 ] && exit 0

today="$(date +%Y-%m-%d)"
current="$(grep -m1 -E "^\*\*Last Updated\*\*:[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}" "$README" \
  | sed -E 's/^\*\*Last Updated\*\*:[[:space:]]+([0-9-]+).*/\1/' || true)"

if [ "$current" = "$today" ]; then
  exit 0
fi

# In-place rewrite via temp file (portable across GNU/BSD sed).
tmp="$(mktemp)"
sed -E "s/^(\*\*Last Updated\*\*:[[:space:]]+)[0-9]{4}-[0-9]{2}-[0-9]{2}/\1${today}/" "$README" > "$tmp"
mv "$tmp" "$README"

git add "$README"
echo "[pre-commit] README.md Last Updated -> ${today}"
